# ==========================================
# S-Lab Production Environment Variables
# ==========================================

# Port for the Node.js Express server (default: 3000)
PORT=3000

# Environment mode ('production' for live deployments, 'development' for local development)
NODE_ENV=production

# Gemini AI API Key (Required for Text-to-Speech narration via gemini-3.8-flash-tts)
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=""
